<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
		<LangVersion>9.0</LangVersion>
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
	</PropertyGroup>

	<!--官方工具链：CSII_TOOLPATH 是「用户级注册表」环境变量，必须显式按 User 作用域取（Playbook 步骤 0）-->
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<ItemGroup>
		<!--本机无 net48 targeting pack；仅编译期参考程序集，PrivateAssets=all 不进产物-->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<!--
	  v0.1.0 计划里唯一可能要用 Harmony 的地方：市辖区面板那颗上传按钮（需求 5）。
	  先按零 Harmony 走（能只挂公开事件就不 hook，Playbook 步骤 1 的更优决策）；
	  真到需要时按 Playbook 步骤 7 的 PackageDownload 2.3.3 覆盖法加，别直接 PackageReference 2.3.3（会让 ILHasher 挂死）。
	-->

	<Target Name="RunModPostProcessor" AfterTargets="AfterBuild" BeforeTargets="DeployWIP" Condition="'$(NeedBuild)'">
		<Error Condition="!Exists('$(ModPostProcessorFullPath)')" Text="Post processor not found: $(ModPostProcessorFullPath)" />
		<Message Text="Run post processor: $(ModPostProcessorArgs)" Importance="high" />
		<Exec Command="$(ModPostProcessorArgs)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" LogStandardErrorAsError="true" />

		<!--
		  前端产物必须与 dll 同目录：FACT ModManager.InitializeUIModules 用
		  AssetDatabase 找 UIModuleAsset，然后 AddHostLocation("ui-mods", 该资产所在目录)。
		  BusLineAutoStops 已验证的形态 = mod.json + <Id>.mjs + <Id>.dll 三件套并排。
		  写在本 Target 体内（AfterBuild 之后、DeployWIP 之前）而不是另开一个 Target：
		  MSBuild 不会因为 AfterTargets/BeforeTargets 就保证两个同级 Target 的先后顺序（Playbook §10 的坑）。
		-->
		<Error Condition="!Exists('$(MSBuildProjectDirectory)\UI\mod.json')" Text="Missing UI\mod.json (UI 模块清单)" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\UI\mod.json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
		<Copy Condition="Exists('$(MSBuildProjectDirectory)\UI\dist\BlueprintHub.mjs')"
		      SourceFiles="$(MSBuildProjectDirectory)\UI\dist\BlueprintHub.mjs"
		      DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
		<Warning Condition="!Exists('$(MSBuildProjectDirectory)\UI\dist\BlueprintHub.mjs')"
		         Text="UI\dist\BlueprintHub.mjs 不存在：先跑 npm --prefix UI run build，否则游戏里没有面板。" />

		<!--
		  入口方块的图案是随包的 .svg：Cohtml 的 mask / 图片只吃「能当资源加载的 URL」，
		  官方整份 index.css/index.js 里 data URI 0 次（详见 UI/src/icons.tsx 的注释）。
		  模组包根就是 coui://ui-mods/（FACT：ModManager.InitializeUIModules 对每个模组
		  AddHostLocation("ui-mods", UIModuleAsset 所在目录)），所以 UI\images\x.svg 必须落到包里的 images\x.svg。
		  DeployWIP 是 OutDir\**\*.* 递归拷贝，因此只要进 OutDir 就会跟着部署。
		-->
		<Error Condition="!Exists('$(MSBuildProjectDirectory)\UI\images\BlueprintHub_Glyph.svg')"
		       Text="UI\images\BlueprintHub_Glyph.svg 不存在：左上角入口会只剩蓝底没有图案。" />
		<ItemGroup>
			<UiImages Include="$(MSBuildProjectDirectory)\UI\images\**\*.svg" />
		</ItemGroup>
		<Copy SourceFiles="@(UiImages)"
		      DestinationFiles="@(UiImages->'$(OutDir)images\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
	</Target>

	<Target Name="RunModPublisher" AfterTargets="Publish">
		<Error Condition="!Exists('$(ModPublisherPath)')" Text="Mod publisher not found: $(ModPublisherPath)" />
		<Message Text="Run mod publisher: $(ModPublisherArgs)" Importance="high" />
		<Exec Command="$(ModPublisherArgs)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" LogStandardErrorAsError="true" />
	</Target>

	<!--UI/ 是 React 前端源码树（node_modules 与 src 里都可能有 .ts/.js；SDK 默认通配 **/*.cs 会把它编进产物）-->
	<ItemGroup>
		<Compile Remove="research\**" />
		<Compile Remove="template\**" />
		<Compile Remove="tests\**" />
		<Compile Remove="tools\**" />
		<Compile Remove="releases\**" />
		<Compile Remove="UI\**" />
		<None Remove="research\**" />
		<None Remove="template\**" />
		<None Remove="tests\**" />
		<None Remove="tools\**" />
		<None Remove="releases\**" />
		<None Remove="UI\**" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Game"><Private>false</Private></Reference>
		<Reference Include="Colossal.Core"><Private>false</Private></Reference>
		<Reference Include="Colossal.Mathematics"><Private>false</Private></Reference>
		<Reference Include="Colossal.Collections"><Private>false</Private></Reference>
		<Reference Include="Colossal.Logging"><Private>false</Private></Reference>
		<Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
		<Reference Include="Colossal.Localization"><Private>false</Private></Reference>
		<Reference Include="Colossal.UI"><Private>false</Private></Reference>
		<Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
		<!--IdentityKit 读 PlatformManager.instance.userSpecificPath 做本机去重键（FACT：api-PlatformManager.txt:200）-->
		<Reference Include="Colossal.PSI.Common"><Private>false</Private></Reference>
		<!--AccountKit 打开官方 ModsUI 个人资料页要用 PdxSdk 平台实例（FACT：research/PdxSdkPlatform.cs 的 ShowModsUIProfilePage）-->
		<Reference Include="Colossal.PSI.PdxSdk"><Private>false</Private></Reference>
		<Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
		<Reference Include="UnityEngine.UIElementsModule"><Private>false</Private></Reference>
		<Reference Include="Unity.InputSystem"><Private>false</Private></Reference>
		<Reference Include="Unity.Burst"><Private>false</Private></Reference>
		<Reference Include="Unity.Collections"><Private>false</Private></Reference>
		<Reference Include="Unity.Entities"><Private>false</Private></Reference>
		<Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
		<Reference Include="System.Net.Http"><Private>false</Private></Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System"><Private>false</Private></Reference>
		<Reference Update="System.Core"><Private>false</Private></Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>

</Project>
